# 复制到 VPS 的 /srv/storage/nameless-worksheet/.env，权限设为 600，切勿入库
APP_IMAGE_TAG=latest
APP_ORIGIN=https://worksheet.45.207.215.102.sslip.io
TRUST_PROXY=172.19.0.0/16

POSTGRES_USER=worksheet
POSTGRES_PASSWORD=REPLACE_WITH_OPENSSL_RAND
POSTGRES_DB=nameless_worksheet

SESSION_TTL_DAYS=30
REALTIME_RETENTION_HOURS=24
REALTIME_REPLAY_LIMIT=500
LOG_LEVEL=info

# 阶段 4：Cloudflare R2 对象存储与直传配置（生产必填，切勿入库）
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
R2_BUCKET=REPLACE_WITH_PRIVATE_R2_BUCKET
# 可选自定义 Endpoint（默认 https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com）
# R2_ENDPOINT=

R2_MAX_FILE_BYTES=10737418240
R2_MULTIPART_THRESHOLD_BYTES=10485760
R2_PART_SIZE_BYTES=10485760
R2_UPLOAD_CONCURRENCY=3
R2_UPLOAD_SIGN_TTL_SEC=600
R2_DOWNLOAD_SIGN_TTL_SEC=600
UPLOAD_SESSION_TTL_HOURS=24
UPLOAD_CLEANUP_GRACE_HOURS=2

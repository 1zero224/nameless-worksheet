{
  "name": "nameless-worksheet",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "db:start": "node scripts/local-db.mjs start",
    "db:stop": "node scripts/local-db.mjs stop",
    "check": "biome check . && pnpm -r --parallel run typecheck",
    "test": "vitest run",
    "e2e": "pnpm build && playwright test",
    "build": "pnpm --filter @nw/shared run build && pnpm --filter @nw/server run build && pnpm --filter @nw/web run build",
    "db:generate": "pnpm --filter @nw/server run db:generate",
    "db:migrate": "pnpm --filter @nw/server run db:migrate",
    "verify": "pnpm check && pnpm test && pnpm e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.6.0-beta.19",
    "fast-check": "4.11.0",
    "pg": "8.23.1",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
